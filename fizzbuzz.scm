(define-macro (lz-cons h t) `(cons ,h (lambda () ,t)))
(define (lz-cdr l) ((cdr l)))
(define (lz-count n)
  (lz-cons n (lz-count (1+ n))))
(define (lz-zip l)
  (lz-cons (map car l) (lz-zip (map lz-cdr l))))
(define (lz-pulse n t)
  (define (lz-loop l)
    (lz-cons (car l) (lz-loop (append (cdr l) `(,(car l))))))
  (lz-loop (reverse `(,t . ,(make-list n #f)))))
(do ((l (lz-zip `( ,(lz-pulse 100 "Written in GNU Guile")
                   ,(lz-pulse  14 'fizzbuzz)
                   ,(lz-pulse   2 'fizz)
                   ,(lz-pulse   4 'buzz)
                   ,(lz-count   1)))
        (and (newline) (lz-cdr l))))
  ((caar l))
  (display (car (delete #f (car l)))))

(define (lazy-count n)
  (cons n (delay (lazy-count (1+ n)))))
(define (lazip l)
  (cons (map car l) (delay (lazip (map force (map cdr l))))))
(define (lazy-pattern n t)
  (define (lazy-loop l)
    (cons (car l) (delay (lazy-loop (append (cdr l) (list (car l)))))))
  (lazy-loop (append (make-list (1- n) #f) (list t))))

(do ((l (lazip (list
                 (lazy-pattern 15 'fizzbuzz)
                 (lazy-pattern  3 'fizz)
                 (lazy-pattern  5 'buzz)
                 (lazy-count 1)))
        (force (cdr l))))
  ((< 100 (cadddr (car l))))
  (display (car (delete #f (car l))))
  (newline))
